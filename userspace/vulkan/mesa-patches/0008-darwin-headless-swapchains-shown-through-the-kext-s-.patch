From 83994125e953230e666f5efd1f52bfc76f9ab08f Mon Sep 17 00:00:00 2001
From: "Sunneva N. Mariu" <sunnevanattsol@gmail.com>
Date: Tue, 13 Oct 2026 14:53:26 +0000
Subject: [PATCH] darwin: headless swapchains shown through the kext's scanout
 calls

RADV on macOS had no window-system layer: a program had to call the
radv_darwin_scanout_* functions itself. Offer VK_KHR_surface and
VK_KHR_swapchain there, with the headless surface as the one platform.

A headless swapchain's images are copied at present into linear buffers
(the CPU image type's buffer blit). When the kext has a display to lend
and the swapchain fits its plane (B8G8R8A8, at most N48N_SCAN_MAX_SLOTS
images, not larger than the plane), those buffers get the plane's shape
and pitch, come from VRAM and are registered as scanout slots; present
waits for the copy and flips to the image's slot. Otherwise the
swapchain works as before and nothing is shown. RADV_DARWIN_SCANOUT=0
leaves the display alone.

The copy goes on the presenting queue: the kext takes no SDMA work from
a client, so the private SDMA blit queue is not created.

Generated-by: LLM
---
 src/amd/vulkan/radv_wsi.c            |   6 ++
 src/amd/vulkan/radv_wsi.h            |   2 +-
 src/vulkan/wsi/wsi_common_headless.c | 116 ++++++++++++++++++++++++++-
 3 files changed, 121 insertions(+), 3 deletions(-)

diff --git a/src/amd/vulkan/radv_wsi.c b/src/amd/vulkan/radv_wsi.c
index d862dad..c988d99 100644
--- a/src/amd/vulkan/radv_wsi.c
+++ b/src/amd/vulkan/radv_wsi.c
@@ -52,6 +52,12 @@ radv_wsi_get_prime_blit_queue(VkDevice _device)
       return &device->private_sdma_queue->vk;
    }
 
+#ifdef __APPLE__
+   /* The kext takes no SDMA work from a client: the copy at present goes on the queue that presents. */
+   simple_mtx_unlock(&device->blit_queue_mtx);
+   return NULL;
+#endif
+
    if (pdev->info.gfx_level >= GFX9 && !RADV_DEBUG(instance, NO_DMA_BLIT)) {
 
       uint32_t queue_family_index = pdev->num_queues;
diff --git a/src/amd/vulkan/radv_wsi.h b/src/amd/vulkan/radv_wsi.h
index 2ab3107..72c1eeb 100644
--- a/src/amd/vulkan/radv_wsi.h
+++ b/src/amd/vulkan/radv_wsi.h
@@ -14,7 +14,7 @@
 #include "radv_physical_device.h"
 
 #if defined(VK_USE_PLATFORM_WAYLAND_KHR) || defined(VK_USE_PLATFORM_XCB_KHR) || defined(VK_USE_PLATFORM_XLIB_KHR) ||   \
-   defined(VK_USE_PLATFORM_DISPLAY_KHR)
+   defined(VK_USE_PLATFORM_DISPLAY_KHR) || defined(__APPLE__)
 #define RADV_USE_WSI_PLATFORM
 #endif
 
diff --git a/src/vulkan/wsi/wsi_common_headless.c b/src/vulkan/wsi/wsi_common_headless.c
index 05906d4..e40d8da 100644
--- a/src/vulkan/wsi/wsi_common_headless.c
+++ b/src/vulkan/wsi/wsi_common_headless.c
@@ -33,6 +33,28 @@
 
 #include "drm-uapi/drm_fourcc.h"
 
+#ifdef __APPLE__
+#include <stdlib.h>
+#include "darwin/navi48_native_abi.h"
+#include "vk_device.h"
+
+/* Darwin: a headless swapchain shows its images on the display the kext lends (radv_darwin_scanout.h). */
+int radv_darwin_scanout_query(VkDevice dev, struct n48n_scan_query *q);
+int radv_darwin_scanout_acquire(VkDevice dev, uint64_t *console_mc, uint64_t *frame_count);
+int radv_darwin_scanout_register(VkDevice dev, VkDeviceMemory mem, uint64_t offset, uint32_t pitch_bytes,
+                                 uint32_t width, uint32_t height, uint32_t *slot, uint64_t *slot_mc);
+int radv_darwin_scanout_present(VkDevice dev, uint32_t slot, uint64_t out[3]);
+int radv_darwin_scanout_release(VkDevice dev, uint64_t out[2]);
+
+/* The buffer an image is copied into, for showing: as the CPU image type's, but never mapped. */
+static VkResult
+wsi_headless_create_scanout_image_mem(const struct wsi_swapchain *chain, const struct wsi_image_info *info,
+                                      struct wsi_image *image)
+{
+   return wsi_create_buffer_blit_context(chain, info, image, 0);
+}
+#endif
+
 struct wsi_headless {
    struct wsi_interface base;
 };
@@ -67,6 +89,11 @@ wsi_headless_surface_get_capabilities(VkIcdSurfaceBase *surface,
    caps->surfaceCapabilities.minImageCount = 4;
    /* There is no real maximum */
    caps->surfaceCapabilities.maxImageCount = 0;
+#ifdef __APPLE__
+   /* One scanout slot an image, and the kext has N48N_SCAN_MAX_SLOTS of them. */
+   caps->surfaceCapabilities.minImageCount = 2;
+   caps->surfaceCapabilities.maxImageCount = N48N_SCAN_MAX_SLOTS;
+#endif
 
    caps->surfaceCapabilities.currentExtent = (VkExtent2D) { -1, -1 };
    caps->surfaceCapabilities.minImageExtent = (VkExtent2D) { 1, 1 };
@@ -213,7 +240,12 @@ wsi_headless_surface_get_formats(VkIcdSurfaceBase *icd_surface,
 {
    VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormatKHR, out, pSurfaceFormats, pSurfaceFormatCount);
 
-   if (wsi_device->force_bgra8_unorm_first) {
+#ifdef __APPLE__
+   const bool bgra_first = true;   /* the display the images are shown on is B8G8R8A8 */
+#else
+   const bool bgra_first = wsi_device->force_bgra8_unorm_first;
+#endif
+   if (bgra_first) {
       vk_outarray_append_typed(VkSurfaceFormatKHR, &out, out_fmt) {
          out_fmt->format = VK_FORMAT_B8G8R8A8_UNORM;
          out_fmt->colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
@@ -261,7 +293,12 @@ wsi_headless_surface_get_formats2(VkIcdSurfaceBase *icd_surface,
 {
    VK_OUTARRAY_MAKE_TYPED(VkSurfaceFormat2KHR, out, pSurfaceFormats, pSurfaceFormatCount);
 
-   if (wsi_device->force_bgra8_unorm_first) {
+#ifdef __APPLE__
+   const bool bgra_first = true;   /* the display the images are shown on is B8G8R8A8 */
+#else
+   const bool bgra_first = wsi_device->force_bgra8_unorm_first;
+#endif
+   if (bgra_first) {
       vk_outarray_append_typed(VkSurfaceFormat2KHR, &out, out_fmt) {
          out_fmt->surfaceFormat.format = VK_FORMAT_B8G8R8A8_UNORM;
          out_fmt->surfaceFormat.colorSpace = VK_COLOR_SPACE_SRGB_NONLINEAR_KHR;
@@ -353,10 +390,16 @@ struct wsi_headless_image {
     * in a loop.
     */
    bool busy_on_device;
+#ifdef __APPLE__
+   uint32_t scanout_slot;
+#endif
 };
 
 struct wsi_headless_swapchain {
    struct wsi_swapchain base;
+#ifdef __APPLE__
+   bool scanout;
+#endif
    struct wsi_headless_image images[0];
 };
 VK_DEFINE_NONDISP_HANDLE_CASTS(wsi_headless_swapchain, base.base, VkSwapchainKHR,
@@ -440,6 +483,22 @@ wsi_headless_swapchain_queue_present(struct wsi_swapchain *wsi_chain,
 
    assert(image_index < chain->base.image_count);
 
+#ifdef __APPLE__
+   if (chain->scanout) {
+      /* The copy into the image's scanout buffer was submitted just before this call: let it finish, then
+       * show the buffer. The kext returns at the vertical blank the flip took effect in. */
+      struct vk_device *vk_dev = vk_device_from_handle(chain->base.device);
+      vk_dev->dispatch_table.DeviceWaitIdle(chain->base.device);
+      int r = radv_darwin_scanout_present(chain->base.device, chain->images[image_index].scanout_slot, NULL);
+      if (r) {
+         fprintf(stderr, "radv-darwin: wsi: present of slot %u failed: %d\n",
+                 chain->images[image_index].scanout_slot, r);
+         chain->images[image_index].busy_on_host = false;
+         return VK_ERROR_SURFACE_LOST_KHR;
+      }
+   }
+#endif
+
    chain->images[image_index].busy_on_host = false;
 
    return VK_SUCCESS;
@@ -461,6 +520,14 @@ wsi_headless_swapchain_destroy(struct wsi_swapchain *wsi_chain,
    struct wsi_headless_swapchain *chain =
       (struct wsi_headless_swapchain *)wsi_chain;
 
+#ifdef __APPLE__
+   if (chain->scanout) {
+      struct vk_device *vk_dev = vk_device_from_handle(chain->base.device);
+      vk_dev->dispatch_table.DeviceWaitIdle(chain->base.device);
+      radv_darwin_scanout_release(chain->base.device, NULL);
+   }
+#endif
+
    for (uint32_t i = 0; i < chain->base.image_count; i++) {
       if (chain->images[i].base.image != VK_NULL_HANDLE)
          wsi_destroy_image(&chain->base, &chain->images[i].base);
@@ -522,7 +589,12 @@ wsi_headless_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
    struct wsi_base_image_params *image_params = NULL;
    struct wsi_cpu_image_params cpu_params;
    struct wsi_drm_image_params drm_params;
+#ifdef __APPLE__
+   /* No DRM here: the image is copied into a linear buffer at present, which is also what the display wants. */
+   if (true) {
+#else
    if (wsi_device->sw) {
+#endif
       cpu_params = (struct wsi_cpu_image_params) {
          .base.image_type = WSI_IMAGE_TYPE_CPU,
       };
@@ -557,6 +629,31 @@ wsi_headless_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
    chain->base.present_mode = wsi_swapchain_get_present_mode(wsi_device, pCreateInfo);
    chain->base.image_count = num_images;
 
+#ifdef __APPLE__
+   /* The display's plane, if the kext has one to lend and the swapchain fits it: the buffers the images are copied
+    * into get the plane's shape and pitch and come from VRAM, unmapped, so that each can be shown as it is. An image smaller
+    * than the plane sits in its top left corner. RADV_DARWIN_SCANOUT=0 leaves the display alone. */
+   struct n48n_scan_query plane;
+   const char *off = getenv("RADV_DARWIN_SCANOUT");
+   const bool bgra = pCreateInfo->imageFormat == VK_FORMAT_B8G8R8A8_UNORM ||
+                     pCreateInfo->imageFormat == VK_FORMAT_B8G8R8A8_SRGB;
+   bool scanout = !(off && off[0] == '0') && num_images <= (int)N48N_SCAN_MAX_SLOTS &&
+                  radv_darwin_scanout_query(device, &plane) == 0;
+   if (scanout && (!bgra || pCreateInfo->imageExtent.width > plane.plane_w ||
+                   pCreateInfo->imageExtent.height > plane.plane_h || plane.pitch_px < plane.plane_w)) {
+      fprintf(stderr, "radv-darwin: wsi: a %ux%u swapchain of format %d does not fit the display's plane (%ux%u, "
+              "B8G8R8A8): not shown\n", pCreateInfo->imageExtent.width, pCreateInfo->imageExtent.height,
+              pCreateInfo->imageFormat, plane.plane_w, plane.plane_h);
+      scanout = false;
+   }
+   if (scanout) {
+      chain->base.image_info.linear_stride = plane.pitch_px * 4;
+      chain->base.image_info.linear_size = (uint64_t)plane.pitch_px * 4 * plane.plane_h;
+      chain->base.image_info.select_blit_dst_memory_type = wsi_select_device_memory_type;
+      chain->base.image_info.create_mem = wsi_headless_create_scanout_image_mem;
+   }
+#endif
+
    uint32_t image = 0;
    for (; image < chain->base.image_count; image++) {
       result = wsi_create_image(&chain->base, &chain->base.image_info,
@@ -568,6 +665,21 @@ wsi_headless_surface_create_swapchain(VkIcdSurfaceBase *icd_surface,
       chain->images[image].busy_on_device = false;
    }
 
+#ifdef __APPLE__
+   if (scanout) {
+      int r = radv_darwin_scanout_acquire(device, NULL, NULL);
+      for (uint32_t i = 0; !r && i < chain->base.image_count; i++)
+         r = radv_darwin_scanout_register(device, chain->images[i].base.blit.memory, 0, plane.pitch_px * 4,
+                                          plane.plane_w, plane.plane_h, &chain->images[i].scanout_slot, NULL);
+      if (r) {
+         fprintf(stderr, "radv-darwin: wsi: the display could not be taken (%d): the swapchain is not shown\n", r);
+         radv_darwin_scanout_release(device, NULL);
+      } else {
+         chain->scanout = true;
+      }
+   }
+#endif
+
    *swapchain_out = &chain->base;
 
    return VK_SUCCESS;
-- 
