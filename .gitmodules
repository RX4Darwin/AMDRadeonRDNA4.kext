[submodule "MacKernelSDK"]
	path = lib/MacKernelSDK
	url = https://github.com/acidanthera/MacKernelSDK.git
[submodule "Lilu"]
	path = lib/Lilu
	url = https://github.com/acidanthera/Lilu.git
[submodule "lib/Mesa"]
	path = lib/Mesa
	url = https://gitlab.freedesktop.org/mesa/mesa.git
	shallow = true
[submodule "lib/FidelityFX-FSR"]
	path = lib/FidelityFX-FSR
	url = https://github.com/GPUOpen-Effects/FidelityFX-FSR.git
[submodule "lib/FidelityFX-SDK"]
	path = lib/FidelityFX-SDK
	url = https://github.com/GPUOpen-LibrariesAndSDKs/FidelityFX-SDK.git
	shallow = true
[submodule "lib/linux"]
	path = lib/linux
	url = https://github.com/torvalds/linux.git
	shallow = true
	update = none
[submodule "lib/linux-firmware"]
	path = lib/linux-firmware
	url = https://gitlab.com/kernel-firmware/linux-firmware.git
	update = none
	shallow = true
